{
  "name": "@denormo/core",
  "version": "0.0.0",
  "description": "ODM-agnostic engine that keeps denormalized MongoDB snapshot fields in sync with their sources",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "mongodb": "^6.20.0 || ^7.0.0"
  },
  "devDependencies": {
    "mongodb": "^7.7.0"
  }
}
